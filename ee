-- ============================================================
--  GÜVENLİ HTTP KATMANI (multi-executor + timeout + tamper)
-- ============================================================
local function httpGet(url, timeout)
    timeout = timeout or CONFIG.HTTP_TIMEOUT
    local fetcher
    if syn and type(syn.request) == "function" then
        fetcher = function(u)
            local r = syn.request({Url = u, Method = "GET"})
            return r and r.Body or nil
        end
    elseif http and type(http.request) == "function" then
        fetcher = function(u)
            local r = http.request({Url = u, Method = "GET"})
            return r and r.Body or nil
        end
    elseif type(request) == "function" then
        fetcher = function(u)
            local r = request({Url = u, Method = "GET"})
            return r and r.Body or nil
        end
    elseif type(game.HttpGet) == "function" then
        fetcher = function(u) return game:HttpGet(u) end
    else
        return nil, "HTTP yok"
    end

    local result, done, err
    task.spawn(function()
        local ok, res = pcall(fetcher, url)
        if ok then result = res else err = tostring(res) end
        done = true
    end)
    local start = tick()
    while not done and (tick() - start) < timeout do
        task.wait(0.1)
    end
    if not done then return nil, "Timeout" end
    if err then return nil, err end
    return result
end

-- ============================================================
--  KEY VALIDATION (güvenli)
-- ============================================================
local function sanitizeKey(raw)
    local k = tostring(raw or "")
    k = k:gsub("^%s+", ""):gsub("%s+$", "")
    return k
end

local function fetchKeyList()
    if type(game.HttpGet) ~= "function" then
        return nil, "Tamper tespit edildi"
    end
    local body, err = httpGet(CONFIG.KEY_LIST_URL, CONFIG.HTTP_TIMEOUT)
    if not body then return nil, err or "Fetch unsuccesful" end
    if type(body) ~= "string" or #body < 4 then
        return nil, "Do you think you're smart?"
    end
    local low = body:lower()
    if low:find("<!doctype") or low:find("<html")
       or low:find("404 not found") or low:find("not found") then
        return nil, "Server error"
    end
    return body, nil
end

local function validateKey(rawKey)
    local key = sanitizeKey(rawKey)
    if #key < CONFIG.MIN_KEY_LEN then
        return false, "The key is very short."
    end
    if #key > CONFIG.MAX_KEY_LEN then
        return false, "The key is too long"
    end
    if key:find("%z") then
        return false, "Invalid character"
    end
    if key:find("[\r\n]") then
        return false, "Invalid format (02)"
    end

    local list, fetchErr = fetchKeyList()
    if not list then
        return false, fetchErr or "Connect Error (244)"
    end

    -- ⚠️ CRITICAL FIX: satır-satır TAM eşleşme (substring bypass engellendi)
    for line in list:gmatch("[^\r\n]+") do
        local trimmed = line:gsub("^%s+", ""):gsub("%s+$", "")
        if trimmed ~= "" and trimmed == key then
            return true, "Verified"
        end
    end
    return false, "Invalid key"
end

-- ============================================================
--  SUBMIT HANDLER
-- ============================================================
SubmitBtn.MouseButton1Click:Connect(function()
    if verifying or verified then return end
    if lockedOut then
        notify("Locked", CONFIG.LOCKOUT_TIME .. "s wait.", true, 4)
        return
    end

    local input = InputBox.Text
    if not input or input == "" then
        notify("Empty", "Please enter a key.", true, 3)
        return
    end

    verifying        = true
    SubmitBtn.Text   = "Verifying..."
    SubmitBtn.Active = false
    StatusLbl.Text   = "Connecting to the server..."
    StatusLbl.TextColor3 = C_ACCENT

    task.spawn(function()
        local ok, reason = validateKey(input)

        if ok then
            verified                     = true
            StatusLbl.Text               = "✓ Verified! Loading..."
            StatusLbl.TextColor3         = C_SUCCESS
            SubmitBtn.Text               = "Verified"
            SubmitBtn.BackgroundColor3   = C_SUCCESS
            notify("Success", "Key verified! Hub is loading...", false, 4)
            task.wait(1.2)
            InputBox.Text = ""
            if ScreenGui and ScreenGui.Parent then
                ScreenGui:Destroy()
            end
            _G.__LightningKeyActive = false
            print("[LightningHub] Key verified! Hub is loading...")

            -- 👇 BURAYA ANA SCRIPTİNİN LOAD KODUNU EKLE
            loadstring(game:HttpGet("https://raw.githubusercontent.com/halilibrahimseviml1/op-script/refs/heads/main/gg"))()
        else
            attempts = attempts + 1
            local remaining = CONFIG.MAX_ATTEMPTS - attempts
            if attempts >= CONFIG.MAX_ATTEMPTS then
                lockedOut               = true
                StatusLbl.Text          = "Locked — " .. CONFIG.LOCKOUT_TIME .. "s Wait"
                StatusLbl.TextColor3    = Color3.fromRGB(255, 100, 100)
                notify("Locked!",
                    "Too many attempts! " .. CONFIG.LOCKOUT_TIME .. "s Try again",
                    true, 4)
                task.delay(CONFIG.LOCKOUT_TIME, function()
                    lockedOut = false
                    attempts  = 0
                    if StatusLbl and StatusLbl.Parent then
                        StatusLbl.Text       = "Enter your key to continue."
                        StatusLbl.TextColor3 = C_TEXT_DIM
                    end
                end)
            else
                StatusLbl.Text       = "✗ " .. (reason or "Invaild")
                                       .. " — " .. remaining .. " attempt remaining"
                StatusLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
                notify("Unsuccessful",
                    (reason or "Invalid key") .. " (" .. remaining .. " attempt remaining)",
                    true, 3)
            end
            SubmitBtn.Text   = "Submit Key"
            SubmitBtn.Active = true
        end
        verifying = false
    end)
end)

